# Copie para .env e preencha:  cp .env.example .env
# Nunca suba o .env para o git (ele já está no .gitignore).

# ─── Login ───────────────────────────────────────────────────────────────
# Gere com:  python -c "import secrets;print(secrets.token_urlsafe(32))"
SECRET_KEY=
# Usuários criados no primeiro boot (não troca senha depois). Cada usuário tem o próprio perfil e kanban.
BOOTSTRAP_USERS=voce:troque-esta-senha
# true quando estiver atrás de HTTPS
COOKIE_SECURE=false

# ─── IA ──────────────────────────────────────────────────────────────────
# Escolha UM provedor. Guia completo: docs/provedores-de-ia.md
#   claude_cli  Claude Code instalado (usa sua assinatura do Claude ou chave)
#   anthropic   API da Anthropic (ANTHROPIC_API_KEY)
#   codex_cli   Codex CLI instalado (usa sua assinatura do ChatGPT ou chave)
#   openai      API da OpenAI (OPENAI_API_KEY)
#   openrouter  OpenRouter, centenas de modelos com uma chave (OPENROUTER_API_KEY)
#   gemini      API do Google Gemini (GEMINI_API_KEY)
#   ollama      modelo local no Ollama, grátis e offline
#   compatible  qualquer API compatível com OpenAI (LM Studio, Groq, DeepSeek...): AI_BASE_URL
#   mock        sem IA, só para testar o fluxo
AI_PROVIDER=mock

# Modelos: vazio = padrão do provedor (ver DEFAULT_MODELS em backend/app/config.py).
# Triagem roda em toda vaga (use um modelo barato); CV roda só quando você pede (use um bom).
AI_MODEL_TRIAGE=
AI_MODEL_CV=

# Chaves (preencha só a do provedor escolhido)
ANTHROPIC_API_KEY=
# Token do Claude Code para servidor/Docker: rode `claude setup-token` e cole aqui
CLAUDE_CODE_OAUTH_TOKEN=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Para AI_PROVIDER=compatible (ou para trocar a URL de outro provedor, ex.: Ollama em outra máquina)
AI_BASE_URL=
AI_API_KEY=

# ─── Perfil de exemplo ───────────────────────────────────────────────────
# Carregado só no primeiro boot, para o primeiro usuário. Deixe vazio para começar do zero.
SEED_PROFILE_DIR=exemplos/demo
SEED_PROFILE_NAME=Ana Exemplo

# ─── Coleta (volume baixo de propósito) ─────────────────────────────────
MAX_SEARCHES_PER_RUN=8
RESULTS_PER_SEARCH=15
MIN_MINUTES_BETWEEN_RUNS=30
# Proxy opcional para o JobSpy (IP de VPS é bloqueado mais rápido pelo LinkedIn): user:pass@host:port,...
JOBSPY_PROXIES=

# ─── MCP (opcional): conecte Claude, Codex, Hermes etc. em /mcp ──────────
# Header: Authorization: Bearer <MCP_TOKEN>. Vazio = MCP desligado.
MCP_TOKEN=
# Usuário cujo kanban o MCP enxerga (vazio = primeiro usuário)
MCP_USER=

# ─── Docker / HTTPS ──────────────────────────────────────────────────────
APP_BIND=127.0.0.1
APP_PORT=8000
DOMAIN=
